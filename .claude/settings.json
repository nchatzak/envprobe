{
  "skills": [
    "https://github.com/unclebob/crap4go/blob/master/SKILL.md"
  ],
  "permissions": {
    "deny": [
      "Bash(sed -i:*)",
      "Write(.claude/**)",
      "Edit(.claude/**)",
      "Edit(scripts/check.sh)",
      "Edit(scripts/crap.sh)",
      "Edit(scripts/guard.sh)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/secrets/**)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(.github/workflows/**)",
      "Edit(**/*.pem)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "gofmt -s -w . 2>/dev/null || true"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^implementer$",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/guard.sh --hook"
          }
        ]
      }
    ]
  }
}
